// Copy to secrets.h and fill in. secrets.h is gitignored and MUST stay
// out of the repository.
//
// This project already has one plaintext-credentials incident to learn
// from: desktop/dist/AWH_Bridge.exe carries real Arduino Cloud and
// InfluxDB credentials in the clear AND was committed, so they are in git
// history and still unrotated. A token in firmware flash is a smaller
// exposure than a token in a public history, but only if it never gets
// committed -- hence the .gitignore entry, added before this file existed.
//
// The token must be WRITE-ONLY and scoped to this one bucket. Not the
// read/write token Grafana uses: a gateway that can only append to
// Atoco_Opta_Live cannot delete history or read anything back, so a board
// pulled out of a panel and dumped over DFU gives up the ability to add
// rows and nothing else.
//
// A board flashed with the placeholder below pushes nothing at all,
// rather than retrying a 401 forever.

#ifndef SECRETS_H
#define SECRETS_H

#define INFLUX_HOST    "us-east-1-1.aws.cloud2.influxdata.com"
#define INFLUX_BUCKET  "Atoco_Opta_Live"
#define INFLUX_TOKEN   "PUT_YOUR_WRITE_ONLY_TOKEN_HERE"

#endif // SECRETS_H

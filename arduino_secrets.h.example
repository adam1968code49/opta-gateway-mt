// =====================================================================
//  arduino_secrets.h.example  -  template (safe to commit)
// =====================================================================
//
//  Copy this file to  arduino_secrets.h  and fill in your real values.
//  arduino_secrets.h is gitignored so real credentials never get committed.
//
//  WiFi: use a hotspot / uplink on a subnet DIFFERENT from the machine
//  network (e.g. an iPhone hotspot = 172.20.10.x). See README.md.
//
#pragma once

#define SECRET_SSID         "YOUR_WIFI_SSID"
#define SECRET_OPTA_PASS    "YOUR_WIFI_PASSWORD"
//  batch 16: password of the board's own setup hotspot "IP2-setup" (WPA2, 8..63 chars).
//  Leave it undefined and the firmware falls back to a built-in default and nags at boot.
#define SECRET_PORTAL_PASS  "CHOOSE_A_HOTSPOT_PASSWORD"

// Provided by Arduino Cloud when the device is provisioned (or leave as-is
// if the Opta is provisioned through the Cloud editor / secure element).
#define SECRET_DEVICE_KEY   "YOUR_DEVICE_SECRET_KEY"
